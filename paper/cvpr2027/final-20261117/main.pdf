/ItalicAngle 0 def
/isFixedPitch false def
/UnderlinePosition -100 def
/UnderlineThickness 50 def
end readonly def
/Encoding 256 array
0 1 255 {1 index exch /.notdef put} for
dup 61 /equal put
dup 105 /i put
dup 110 /n put
dup 111 /o put
dup 49 /one put
dup 43 /plus put
dup 116 /t put
dup 50 /two put
dup 117 /u put
dup 48 /zero put
readonly def
currentdict end
